# Copy to .env and adjust. Every value is optional; the defaults work out of the box.

# --- Network ---------------------------------------------------------------
# Host address and port of the web UI. Keep 127.0.0.1: publish through a tunnel or a
# TLS reverse proxy instead of exposing the port.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Public URL(s) of the app, comma-separated; the first is the canonical one. When set,
# browsers may only send state-changing requests from these origins. Example:
#   APP_ORIGIN=https://loop-code.example.com,http://localhost:8080
APP_ORIGIN=

# Secure cookies: auto (when the request came over HTTPS, e.g. via Cloudflare) | true | false
COOKIE_SECURE=auto

# Sites that may show Loop Coder inside an iframe, space-separated:
#   none (default: no site) | self | https:// origins, e.g.
#   FRAME_ANCESTORS=https://example.com https://*.example.com
# Signing in inside the frame only works when the embedding page is on the same site
# (the same registrable domain, e.g. example.com and loop-coder.example.com).
FRAME_ANCESTORS=none

# --- Cloudflare Tunnel (optional) ------------------------------------------
# Token of a tunnel whose public hostname points to http://web:8080.
# Start with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- First-run setup -------------------------------------------------------
# One-time code for the onboarding wizard. Leave empty to get a random code in the logs:
#   docker compose logs api | grep -i "setup code"
SETUP_CODE=

# ---- AI providers --------------------------------------------------------------
# Encrypts AI provider API keys at rest (Administration → AI providers). Create it with
# `npm run secrets-key`, which writes a random key here without showing it. Back it up apart
# from the database: without it the saved keys cannot be read.
LOOP_SECRETS_KEY=

# --- Projects ----------------------------------------------------------------
# Host folder where Claude Code writes project code: <dir>/<workspace-slug>/<project-key>
# It is mounted read-only into the API for the in-app file browser.
WORKSPACES_HOST_DIR=./workspaces

# --- Operations --------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# Set automatically by `npm run up` (scripts/compose.mjs) and `npm run release`.
APP_VERSION=0.7.1
GIT_SHA=
BUILD_TIME=
